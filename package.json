{
  "name": "cold-call-classroom",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "expo-doctor",
    "build:web": "expo export --platform web && node scripts/prepare-web.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/node": "~24.13.3",
    "@types/react": "~19.2.2",
    "tsx": "~4.23.12",
    "typescript": "~5.9.2"
  }
}
